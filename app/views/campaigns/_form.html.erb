<%= form_with(model: campaign, local: true, class: "needs-validation") do |form| %>
  <% if campaign.errors.any? %>
    <div class="alert alert-danger">
      <h4><%= pluralize(campaign.errors.count, "error") %> prohibited this campaign from being saved:</h4>
      <ul>
        <% campaign.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= form.label :name, class: "form-label" %>
    <%= form.text_field :name, class: "form-control", placeholder: "e.g., Tiki Laptop Hunt" %>
  </div>

  <div class="mb-3">
    <%= form.label :keyword, "Search Keyword", class: "form-label" %>
    <%= form.text_field :keyword, class: "form-control", placeholder: "e.g., laptop" %>
  </div>

  <div class="row">
    <div class="col-md-6 mb-3">
      <%= form.label :target_source, "Data Source", class: "form-label" %>
      <%= form.select :target_source, ["tiki", "shopee", "amazon", "lazada"], { prompt: "Select source" }, class: "form-select" %>
    </div>

    <div class="col-md-6 mb-3">
      <%= form.label :frequency, class: "form-label" %>
      <%= form.select :frequency, ["hourly", "daily", "manual"], { prompt: "Select frequency" }, class: "form-select" %>
    </div>
  </div>

  <div class="row">
    <div class="col-md-6 mb-3">
      <%= form.label :status, class: "form-label" %>
      <%= form.select :status, ["active", "paused", "stopped"], { prompt: "Select status" }, class: "form-select" %>
    </div>
  </div>

  <div class="d-flex gap-2">
    <%= form.submit class: "btn btn-primary" %>
    <%= link_to "Cancel", campaigns_path, class: "btn btn-secondary" %>
  </div>
<% end %>
